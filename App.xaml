<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TabBarColorRepro.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="TabOrange">#F58220</Color>
            <Color x:Key="TabUnselected">#64748B</Color>
            <Color x:Key="TabBackground">#FFFFFF</Color>
            <Color x:Key="OffBlack">#1F1F1F</Color>
            <Color x:Key="White">#FFFFFF</Color>
            <Color x:Key="Primary">#F58220</Color>
            <Color x:Key="PrimaryDark">#F58220</Color>
            <Color x:Key="Gray300">#D1D1D1</Color>
            <Color x:Key="Gray400">#ACACAC</Color>
            <Color x:Key="Gray500">#919191</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="#F6F7F9" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#182230" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource TabOrange}" />
                <Setter Property="TextColor" Value="#182230" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
